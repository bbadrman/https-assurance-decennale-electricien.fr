<section class="py-20 bg-surface relative overflow-hidden">
    <div class="bg-orb w-80 h-80 bg-green-200 top-10 left-10" style="animation-delay: 0s"></div>
    <div class="bg-orb w-60 h-60 bg-purple-200 bottom-20 right-10" style="animation-delay: -8s"></div>

    <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
            <div class="text-center mb-12 reveal">
                <h2 class="text-4xl font-bold text-dark mb-4">FAQ</h2>
                <div class="w-24 h-1 bg-yellow-400 mx-auto rounded-full"></div>
            </div>

            <div class="space-y-4" id="faq-container">
                {% for item in items|default([]) %}
                    <div class="border border-gray-200 rounded-3xl overflow-hidden bg-white shadow-sm hover:shadow-xl transition-all duration-300 reveal hover-lift" style="animation-delay: {{ loop.index0 * 0.1 }}s">
                        <button onclick="toggleFAQ({{ loop.index0 }})" class="w-full px-6 py-4 text-left flex justify-between items-center hover:bg-yellow-50 transition-colors faq-toggle" data-index="{{ loop.index0 }}">
                            <span class="font-semibold text-dark">{{ item.question }}</span>
                            <i class="fas fa-chevron-down text-yellow-500 transition-transform duration-300 faq-icon" data-icon-index="{{ loop.index0 }}"></i>
                        </button>

                        <div class="overflow-hidden transition-all duration-300 ease-in-out max-h-0 opacity-0 faq-content" data-content-index="{{ loop.index0 }}">
                            <div class="px-6 py-4 bg-yellow-50 border-t border-gray-100">
                                <p class="text-gray-700 leading-relaxed">{{ item.answer }}</p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>